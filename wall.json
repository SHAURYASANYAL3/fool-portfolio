   "repo": "nsoc",
   "path": "scripts/finalize_verified_data.py",
   "sha": "c463089a8846987bc5206a969cc7a23348f0a62d",
   "lang": "python",
   "firstLine": 1,
   "url": "https://github.com/SHAURYASANYAL3/nsoc/blob/c463089a8846987bc5206a969cc7a23348f0a62d/scripts/finalize_verified_data.py",
   "lines": [
    "import json",
    "import time",
    "",
    "with open(\"nsoc_projects.json\", \"r\", encoding=\"utf-8\") as f:",
    "    projects = json.load(f)",
    "",
    "with open(\"nsoc_dashboard_data.json\", \"r\", encoding=\"utf-8\") as f:",
    "    raw_data = json.load(f)",
    "",
    "repo_owners = {}",
    "project_by_repo = {}",
    "for p in projects:",
    "    repo_clean = p.get(\"repo\", \"\").replace(\"https://github.com/\", \"\").strip(\"/\").lower()",
    "    if \"/\" in repo_clean:",
    "        owner = repo_clean.split(\"/\")[0]",
    "        repo_owners[owner] = repo_clean",
    "        project_by_repo[repo_clean] = p",
    "",
    "all_prs = []",
    "for c in raw_data.get(\"leaderboard\", []):",
    "    for pr in c.get(\"prs\", []):",
    "        all_prs.append(pr)",
    "",
    "unique_prs = {}",
    "for pr in all_prs:",
    "    unique_prs[pr[\"html_url\"]] = pr",
    "",
    "prs_list = list(unique_prs.values())",
    "",
    "contributors = {}",
    "repo_stats = {}",
    "prs_by_repo = {}",
    "",
    "for pr in prs_list:",
    "    author = pr.get(\"author\", \"unknown\")",
    "    if author == \"unknown\" or \"[bot]\" in author:",
    "        continue",
    "",
    "    repo = pr.get(\"repo\", \"\")",
    "    repo_clean = repo.lower()",
    "    repo_owner = repo_clean.split(\"/\")[0] if \"/\" in repo_clean else \"\"",
    "",
    "    is_self_contribution = (author.lower() == repo_owner)",
    "    pr[\"is_self_contribution\"] = is_self_contribution",
    "",
    "    is_merged = pr.get(\"is_merged\", False)",
    "    if is_self_contribution:",
    "        pr[\"valid_points\"] = 0",
    "        pr[\"invalidation_reason\"] = \"Self-contribution by Project Admin (Rule 3 & 10 violation)\"",
    "    else:",
    "        pr[\"valid_points\"] = pr.get(\"points\", 0) if is_merged else 0",
    "        pr[\"invalidation_reason\"] = None",
    "",
    "    # Group by repo",
    "    if repo not in prs_by_repo:",
    "        prs_by_repo[repo] = []",
    "    prs_by_repo[repo].append(pr)",
    "",
    "    # Contributor tracking",
    "    if author not in contributors:",
    "        contributors[author] = {",
    "            \"username\": author,",
    "            \"avatar_url\": pr.get(\"avatar_url\", \"\"),",
    "            \"profile_url\": f\"https://github.com/{author}\",",
    "            \"total_points\": 0,",
    "            \"merged_prs_count\": 0,",
    "            \"open_prs_count\": 0,",
    "            \"level1_count\": 0,",
    "            \"level2_count\": 0,",
    "            \"level3_count\": 0,",
    "            \"self_contributions_count\": 0,",
    "            \"is_project_admin\": (author.lower() in repo_owners),",
    "            \"prs\": [],",
    "            \"repos_contributed\": set()",
    "        }",
    "",
    "    contributors[author][\"prs\"].append(pr)",
    "    contributors[author][\"repos_contributed\"].add(repo)",
    "",
    "    if is_self_contribution:"
   ]
