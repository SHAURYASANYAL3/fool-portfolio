    "# -*- coding: utf-8 -*-",
    "\"\"\"",
    "Database of known disposable/temporary email domains and common free providers.",
    "\"\"\"",
    "",
    "# Common Free Webmail Services",
    "FREE_PROVIDERS = {",
    "    \"gmail.com\", \"googlemail.com\", \"yahoo.com\", \"ymail.com\", \"rocketmail.com\",",
    "    \"outlook.com\", \"hotmail.com\", \"live.com\", \"msn.com\", \"icloud.com\", \"me.com\",",
    "    \"mac.com\", \"proton.me\", \"protonmail.com\", \"aol.com\", \"zoho.com\", \"gmx.com\",",
    "    \"gmx.net\", \"mail.com\", \"tutanota.com\", \"tuta.io\", \"fastmail.com\", \"yandex.com\"",
    "}",
    "",
    "# Extensive List of Known Disposable / Burner Domains",
    "DISPOSABLE_DOMAINS = {",
    "    \"mailinator.com\", \"guerrillamail.com\", \"guerrillamail.net\", \"guerrillamail.biz\",",
    "    \"guerrillamail.org\", \"sharklasers.com\", \"grr.la\", \"guerrillamailblock.com\",",
    "    \"10minutemail.com\", \"10minutemail.net\", \"10minute.email\", \"temp-mail.org\",",
    "    \"tempmail.com\", \"tempmail.net\", \"fakemailgenerator.com\", \"throwawaymail.com\",",
    "    \"yopmail.com\", \"yopmail.fr\", \"yopmail.net\", \"cool.fr.nf\", \"jetable.fr.nf\",",
    "    \"nospam.ze.tc\", \"nomail.xl.cx\", \"mega.zik.dj\", \"speed.1s.fr\", \"courriel.fr.nf\",",
    "    \"moncourrier.fr.nf\", \"monemail.fr.nf\", \"monmail.fr.nf\", \"dispostable.com\",",
    "    \"getairmail.com\", \"trashmail.com\", \"trashmail.net\", \"trashmail.me\", \"trash-mail.com\",",
    "    \"maildrop.cc\", \"inboxkitten.com\", \"nada.ltd\", \"getnada.com\", \"dropmail.me\",",
    "    \"burnermail.io\", \"crazymailing.com\", \"mytemp.email\", \"emailondeck.com\",",
    "    \"mohmal.com\", \"mohmal.in\", \"fakeinbox.com\", \"tempail.com\", \"disposablemail.com\",",
    "    \"clipmail.eu\", \"generator.email\", \"armyspy.com\", \"cuvox.de\", \"dayrep.com\",",
    "    \"einrot.com\", \"fleckens.hu\", \"gustr.com\", \"jourrapide.com\", \"rhyta.com\",",
    "    \"superrito.com\", \"teleworm.us\", \"chacuo.net\", \"discard.email\", \"discardmail.com\",",
    "    \"spambox.us\", \"trashinbox.com\", \"mintemail.com\", \"binkmail.com\", \"bobmail.info\",",
    "    \"chammy.info\", \"devnullmail.com\", \"letthemeatspam.com\", \"mailin8r.com\",",
    "    \"mailinator2.com\", \"notmailinator.com\", \"reallymymail.com\", \"reconmail.com\",",
    "    \"safetymail.info\", \"sendspamhere.com\", \"sogetthis.com\", \"spambooger.com\",",
    "    \"spamherelots.com\", \"spamhereplease.com\", \"suremail.info\", \"thisisnotmyrealemail.com\",",
    "    \"tradermail.info\", \"veryrealemail.com\", \"zippymail.info\", \"tempr.email\"",
    "}",
    "",
    "def is_disposable(domain: str) -> bool:",
    "    \"\"\"Checks if the given domain belongs to a disposable/burner email service.\"\"\"",
    "    domain = domain.strip().lower()",
    "    if domain in DISPOSABLE_DOMAINS:",
    "        return True",
    "    # Subdomain check",
    "    for disp in DISPOSABLE_DOMAINS:",
    "        if domain.endswith(\".\" + disp):",
    "            return True",
    "    return False",
    "",
    "def is_free_provider(domain: str) -> bool:",
    "    \"\"\"Checks if the given domain is a popular free consumer provider.\"\"\"",
    "    return domain.strip().lower() in FREE_PROVIDERS",
    ""
   ]
  }
