    "# -*- coding: utf-8 -*-",
    "\"\"\"",
    "Terminal visual styles, ANSI colors, and cyberpunk banner.",
    "\"\"\"",
    "",
    "class Colors:",
    "    RESET   = '\\033[0m'",
    "    BOLD    = '\\033[1m'",
    "    DIM     = '\\033[2m'",
    "",
    "    # Foreground",
    "    RED     = '\\033[91m'",
    "    GREEN   = '\\033[92m'",
    "    YELLOW  = '\\033[93m'",
    "    BLUE    = '\\033[94m'",
    "    MAGENTA = '\\033[95m'",
    "    CYAN    = '\\033[96m'",
    "    WHITE   = '\\033[97m'",
    "    GRAY    = '\\033[90m'",
    "",
    "    # Badges",
    "    TAG_INFO = f\"{CYAN}[*]{RESET}\"",
    "    TAG_SUCCESS = f\"{GREEN}[+]{RESET}\"",
    "    TAG_WARN = f\"{YELLOW}[!]{RESET}\"",
    "    TAG_FAIL = f\"{RED}[-]{RESET}\"",
    "    TAG_OSINT = f\"{MAGENTA}[#]{RESET}\"",
    "    TAG_SEC = f\"{BLUE}[🛡]{RESET}\"",
    "",
    "BANNER = f\"\"\"{Colors.CYAN}{Colors.BOLD}",
    "  ██╗  ██╗███╗   ██╗ ██████╗  ██████╗██╗  ██╗███╗   ███╗ █████╗ ██╗██╗",
    "  ██║ ██╔╝████╗  ██║██╔═══██╗██╔════╝██║ ██╔╝████╗ ████║██╔══██╗██║██║",
    "  █████═╝ ██╔██╗ ██║██║   ██║██║     █████═╝ ██╔████╔██║███████║██║██║",
    "  ██╔═██╗ ██║╚██╗██║██║   ██║██║     ██╔═██╗ ██║╚██╔╝██║██╔══██║██║██║",
    "  ██║ ╚██╗██║ ╚████║╚██████╔╝╚██████╗██║ ╚██╗██║ ╚═╝ ██║██║  ██║██║███████╗",
    "  ╚═╝  ╚═╝╚═╝  ╚═══╝ ╚═════╝  ╚═════╝╚═╝  ╚═╝╚═╝     ╚═╝╚═╝  ╚═╝╚═╝╚══════╝",
    "{Colors.RESET}{Colors.GRAY}             [+] Advanced Email OSINT & Reconnaissance Framework [+]",
    "{Colors.MAGENTA}                           v2.0.0 - Next-Gen Edition{Colors.RESET}",
    "\"\"\"",
    "",
    "def print_banner():",
    "    print(BANNER)",
    "",
    "def badge_status(status_str):",
    "    s = str(status_str).upper()",
    "    if s in [\"VERIFIED\", \"FOUND\", \"VALID\", \"TRUE\", \"PASS\", \"CONFIRMED\"]:",
    "        return f\"{Colors.GREEN}{Colors.BOLD}[ {status_str} ]{Colors.RESET}\"",
    "    elif s in [\"DISPOSABLE\", \"WARN\", \"QUARANTINE\", \"FILTERED\", \"SUSPICIOUS\"]:",
    "        return f\"{Colors.YELLOW}{Colors.BOLD}[ {status_str} ]{Colors.RESET}\"",
    "    elif s in [\"NOT FOUND\", \"NOTFD\", \"INVALID\", \"FAIL\", \"REJECT\", \"BLOCKED\"]:",
    "        return f\"{Colors.RED}{Colors.BOLD}[ {status_str} ]{Colors.RESET}\"",
    "    else:",
    "        return f\"{Colors.CYAN}{Colors.BOLD}[ {status_str} ]{Colors.RESET}\"",
    ""
   ]
